# Copy to .env (git-ignored). TEMPORARY shared Basic-auth credentials.
PROGIMAGE_AUTH_USERNAME=admin
PROGIMAGE_AUTH_PASSWORD=change-me

# Upload limits (optional; defaults shown).
# PROGIMAGE_MAX_UPLOAD_BYTES=10485760
# PROGIMAGE_MAX_IMAGE_PIXELS=40000000

# PostgreSQL (see docker-compose.yml; `make db-up && make migrate`).
PROGIMAGE_DATABASE_URL=postgresql+psycopg://progimage:progimage@localhost:5433/progimage

# Storage backend: "local" (default, uses PROGIMAGE_STORAGE_DIR) or "s3" (needs `uv sync --extra s3`).
PROGIMAGE_STORAGE_BACKEND=local
# PROGIMAGE_S3_BUCKET=your-bucket
# PROGIMAGE_S3_REGION=eu-west-2
# PROGIMAGE_AWS_ACCESS_KEY_ID=changeme
# PROGIMAGE_AWS_SECRET_ACCESS_KEY=changeme

# Rate limiting per client IP, per minute (optional; defaults shown). "memory" counts per process; Docker uses
# "redis" (set in docker-compose.yml). For "redis" locally: `make db-up`, then the URL below.
# PROGIMAGE_RATE_LIMIT_ENABLED=true
# PROGIMAGE_RATE_LIMIT_BACKEND=memory
# PROGIMAGE_REDIS_URL=redis://localhost:6380/0
# PROGIMAGE_RATE_LIMIT_WRITE_PER_MINUTE=30
# PROGIMAGE_RATE_LIMIT_READ_PER_MINUTE=600

# Docker (`make up`) only: uvicorn worker count and the host port the API is published on.
# WEB_CONCURRENCY=2
# Behind a load balancer: its IPs, so uvicorn takes the client IP (used by the rate limiter) from X-Forwarded-For.
# FORWARDED_ALLOW_IPS=10.0.0.0/8
# API_PORT=8080
